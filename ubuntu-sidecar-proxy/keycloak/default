server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    root /usr/share/nginx/html;
    index index.html index.htm;

    server_name _;
    location / {
        try_files $uri $uri/ =404;
    }
    
    location /auth/admin/realms/master/console {
    	proxy_pass		http://localhost:8080/auth/admin/master/console;
    }
    
    location /auth {
    	proxy_pass 		http://localhost:8080;
	proxy_set_header 	X-Real-IP 		$remote_addr;
	proxy_set_header 	X-Forwarded-For 	$proxy_add_x_forwarded_for;
	proxy_set_header 	X-Forwarded-Proto 	$scheme;
	proxy_set_header 	X-Forwarded-Host 	keycloak.psn.local;
	proxy_set_header 	X-Forwarded-Port 	8888;
    	add_header 		Set-Cookie 		$http_cookie;
    }
}
